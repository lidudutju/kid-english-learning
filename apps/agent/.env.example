# Copy to apps/agent/.env and fill in. This file is the only thing that differs between
# machines — moving the Agent to another Mac means copying this and running `pnpm install`.

# Where the Worker lives. Use http://127.0.0.1:8787 to talk to `wrangler dev`.
KEL_API_BASE_URL=https://app.felixli.io

# Must match the AGENT_TOKEN secret on the Worker.
KEL_AGENT_TOKEN=

# R2 credentials: Cloudflare dashboard → R2 → Manage API Tokens → Object Read & Write,
# scoped to the kel-media bucket only.
KEL_R2_ACCOUNT_ID=
KEL_R2_ACCESS_KEY_ID=
KEL_R2_SECRET_ACCESS_KEY=
KEL_R2_BUCKET=kel-media

# --- optional ---------------------------------------------------------------------

# Defaults to this machine's hostname. Set it if you run two Agents on one machine.
# KEL_AGENT_ID=

# Scratch space for downloads. Defaults to ~/.kel-agent/work. Needs a few GB free.
# KEL_WORK_DIR=

# 1080p is already more than a phone or a TV needs for nursery rhymes.
# KEL_MAX_HEIGHT=1080

# KEL_POLL_INTERVAL_MS=10000
# KEL_HEARTBEAT_MS=2000

# Only needed if `pnpm doctor` says they are not on PATH.
# KEL_YTDLP_PATH=yt-dlp
# KEL_FFMPEG_PATH=ffmpeg
# KEL_FFPROBE_PATH=ffprobe

# A Netscape-format cookies.txt, if YouTube starts asking this machine to prove it is human.
# KEL_COOKIES_FILE=
