{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM only for the `URL` type. This package must stay runtime-agnostic — it is imported by
    // the Worker, the browser and the Node Agent alike — so nothing here may touch `document`
    // or `window`.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
